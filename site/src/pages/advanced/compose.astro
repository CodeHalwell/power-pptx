---
import DocsLayout from "@/layouts/DocsLayout.astro";
import Code from "@/components/Code.astro";

const fromSpec = `from power_pptx.compose import from_spec

prs = from_spec({
    "meta": {"title": "Quarterly Review"},
    "slides": [
        {"layout": "title",
         "title": "Q4 Review",
         "subtitle": "Engineering"},
        {"layout": "bullets",
         "title": "Highlights",
         "bullets": ["Shipped v2.10", "Lint pass clean"]},
        {"layout": "pipeline",
         "title": "How it works",
         "steps": ["Extract", "Classify", "Enrich", "Output"]},
    ],
}, lint="raise")       # built-in lint gate: raise | warn | off

prs.save("q4.pptx")`;
const snippet0 = `from power_pptx.compose import import_slide

source = Presentation("template.pptx")
import_slide(prs, source.slides[2])     # deep-copies slide + related parts`;

const snippet1 = `from power_pptx.compose import apply_template

apply_template(prs, "corporate.potx")   # masters, layouts and theme`;

---

<DocsLayout
  title="Compose & Templates"
  description="Build decks from JSON specs, import slides between decks, and apply templates — with a built-in lint gate."
>
  <p class="lead">
    <code>power_pptx.compose</code> covers JSON-first authoring and cross-presentation operations:
    <code>from_spec</code>, <code>import_slide</code> and <code>apply_template</code>.
  </p>

  <h2 id="from-spec">from_spec — JSON authoring</h2>
  <Code code={fromSpec} />
  <p>
    With <code>lint="raise"</code> the build fails fast on geometry errors — ideal in CI or agent
    pipelines where a broken deck is worse than no deck.
  </p>

  <h2 id="import-slide">import_slide — copy slides between decks</h2>
  <Code code={snippet0} />

  <h2 id="apply-template">apply_template</h2>
  <Code code={snippet1} />

  <h2 id="when">When to use which</h2>
  <table>
    <thead>
      <tr><th>Need</th><th>Use</th></tr>
    </thead>
    <tbody>
      <tr><td>Deck from LLM/DB/JSON output</td><td><code>from_spec</code></td></tr>
      <tr><td>Reuse slides across decks</td><td><code>import_slide</code></td></tr>
      <tr><td>Re-skin an existing deck</td><td><code>apply_template</code></td></tr>
      <tr><td>Re-palette + re-font only</td><td><a href="theme">theme writer</a></td></tr>
    </tbody>
  </table>
</DocsLayout>
