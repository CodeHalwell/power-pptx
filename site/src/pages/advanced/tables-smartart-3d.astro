---
import DocsLayout from "@/layouts/DocsLayout.astro";
import Code from "@/components/Code.astro";
const snippet0 = `from power_pptx import Presentation, BBox
from power_pptx.util import Pt

prs = Presentation()
slide = prs.slides.add_slide(prs.slide_layouts[6])   # Blank

rows, cols = 4, 3
table = slide.shapes.add_table(
    rows, cols, *BBox.from_inches(1, 1.5, 8, 4),
    style="clean",                # disables every inherited style flag
).table

cell = table.cell(0, 0)
cell.text = "Quarter"
cell.fill.solid()
cell.fill.fore_color.rgb = "#0B5CFF"

# Per-cell borders (fork addition): per-edge LineFormat proxies
cell.borders.bottom.color.rgb = "#0D0D0D"
cell.borders.bottom.width = Pt(1.5)
cell.borders.all(width=Pt(0.5), color="#E5E7EB")   # or outer() / none()`;

const snippet1 = `# Replace the text inside an existing template's SmartArt
sa_prs = Presentation("org-chart-template.pptx")
sa = sa_prs.slides[0].smart_art[0]
print(sa.texts)                          # existing node text, document order

sa.set_text(["Discover", "Design", "Deliver"])   # must match node count
sa.set_text(["Alex", "Priya"], strict=False)     # or truncate/pad`;

const snippet2 = `from power_pptx.enum.shapes import MSO_SHAPE
from power_pptx.enum.dml import BevelPreset, PresetMaterial

shape = slide.shapes.add_shape(MSO_SHAPE.OVAL, *BBox.from_inches(1, 1, 2, 2))

td = shape.three_d
td.bevel_top.preset = BevelPreset.CIRCLE
td.bevel_top.width = Pt(6)
td.bevel_top.height = Pt(6)
td.extrusion_height = Pt(12)
td.extrusion_color = "#0B5CFF"
td.preset_material = PresetMaterial.METAL`;

---

<DocsLayout
  title="Tables, SmartArt & 3D"
  description="The inherited table API plus Cell.borders, SmartArt text substitution, and bevel/extrusion 3D primitives."
>
  <p class="lead">
    Three smaller but powerful corners of the API: styled tables, text substitution inside
    SmartArt, and real 3D bevel/extrusion primitives.
  </p>

  <h2 id="tables">Tables</h2>
  <Code code={snippet0} />
  <p>
    Use <code>style="clean"</code> whenever you'll set custom cell borders or fills — inherited
    style flags otherwise fight your formatting.
  </p>

  <h2 id="smartart">SmartArt text substitution</h2>
  <Code code={snippet1} />
  <p>
    This is the pragmatic way to use SmartArt: design the diagram once in PowerPoint, then fill it
    from Python at generation time.
  </p>

  <h2 id="three-d">3D primitives</h2>
  <Code code={snippet2} />
  <p>
    Bevels and extrusion are real DrawingML — they stay editable in PowerPoint and respect the
    theme's lighting rig.
  </p>
</DocsLayout>
