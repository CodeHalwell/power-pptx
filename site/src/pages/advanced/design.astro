import DocsLayout from "@/layouts/DocsLayout.astro";
import Code from "@/components/Code.astro";
const snippet0 = `from power_pptx.design.tokens import DesignTokens

tokens = DesignTokens.from_dict({
    "palette": {
        "primary": "#0B5CFF",
        "surface": "#FFFFFF",
        "ink": "#0D0D0D",
    },
    "typography": {
        "heading": {"family": "Inter", "size": 44, "bold": True},
        "body":    {"family": "Inter", "size": 18},
    },
    "shadows": {"card": {"blur": 18, "distance": 4, "alpha": 0.18}},   # blur = blur_radius
    "radii": {"card": 8},            # bare numbers are points
    "spacings": {"sm": 8, "md": 16},
})

# ...or from YAML (needs pyyaml) or extracted from an existing .pptx
tokens_from_yaml = DesignTokens.from_yaml("brand.yaml")
tokens_from_deck = DesignTokens.from_pptx("brand-deck.pptx")   # accent1..6, fonts
# from_pptx also takes a pathlib.Path, an open binary file or a Presentation

# Per-call tweaks: dotted paths or nested dicts, same unit rule
tokens = tokens.with_overrides({"typography.heading.size": 40})`;

const snippet1 = `from power_pptx import Presentation, BBox
from power_pptx.enum.shapes import MSO_SHAPE

prs = Presentation()
slide = prs.slides.add_slide(prs.slide_layouts[6])   # Blank
shape = slide.shapes.add_shape(
    MSO_SHAPE.ROUNDED_RECTANGLE, *BBox.from_inches(1, 1, 3, 2)
)

# Attribute setters fan out to the low-level fill/line/font/effect proxies
shape.style.fill = tokens.palette["primary"]
shape.style.line = tokens.palette["ink"]
shape.style.text_color = tokens.palette["surface"]
shape.style.font = tokens.typography["body"]
shape.style.shadow = tokens.shadows["card"]   # assign None to clear`;

const snippet2 = `from power_pptx.design.layout import Grid, Stack
from power_pptx.util import Inches, Pt

# Grid computes cells; place() moves an existing shape into a cell span
grid = Grid(slide, cols=3, rows=2, gutter=Pt(12), margin=Pt(48))
for i in range(3):
    cell = grid.cell(col=i, row=0)           # a Box — splats into add_*
    slide.shapes.add_text(*cell, text=f"Tile {i + 1}", align="center")

# Stack walks a cursor down (or across) as you place shapes
stack = Stack(direction="vertical", gap=Pt(8),
              left=Inches(1), top=Inches(4), width=Inches(8))
caption = slide.shapes.add_text(BBox.from_inches(1, 4, 8, 0.6), text="Caption")
stack.place(caption, height=Pt(28))`;

const snippet3 = `from power_pptx.design.recipes import (
    title_slide, bullet_slide, kpi_slide, quote_slide, image_hero_slide,
)

title_slide(prs, title="Q4 Review", subtitle="Engineering", tokens=tokens)
bullet_slide(prs, title="Highlights",
             bullets=["Shipped v2.10", "Lint pass clean"], tokens=tokens)
kpi_slide(prs, title="KPIs",
          kpis=[{"label": "ARR", "value": "$4.2M", "delta": +0.08}],
          tokens=tokens)
quote_slide(prs, quote="Ship it.", attribution="The team", tokens=tokens)
image_hero_slide(prs, title="Big news", image="hero.png", tokens=tokens)`;

const snippet3b = `from power_pptx.design.recipes import (
    code_slide, figure_slide, table_slide,
)

# Bare numbers are relative weights: [2, 1, 1] == [50, 25, 25] == [0.5, 0.25, 0.25]
table_slide(prs, title="Pipeline", columns=["Region", "Owner", "Notes"],
            rows=[["EMEA", "Priya", "Recovered"], ["AMER", "Sam", "Slipped"]],
            widths=[2, 1, 1], tokens=tokens)

# Keeps the figure's aspect ratio; fit="cover" crops, fit="stretch" distorts
figure_slide(prs, title="Adoption", figure="chart.png", fit="contain", tokens=tokens)

# Fitted 14pt down to 9pt; longer code is cut with "... (+N more lines)"
code_slide(prs, title="CI step", code=source, language="python",
           overflow="truncate",        # or "raise"
           font="JetBrains Mono", tokens=tokens)

kpi_slide(prs, title="Too many",
          kpis=[{"label": f"K{i}", "value": "1"} for i in range(10)])
# ValueError: kpi_slide: 10 KPIs do not fit in one row on a slide this wide;
#   at most 9 fit. Split them across slides.`;

const snippet4 = `from power_pptx import (
    add_kpi_card, add_progress_bar, add_gauge,
    add_status_pill, add_stat_strip, add_article_card,
)
from power_pptx.util import Inches

canvas = prs.slides.add_slide(prs.slide_layouts[6])

kpi = add_kpi_card(canvas, left=Inches(0.5), top=Inches(0.5),
                   width=Inches(2.5), height=Inches(1.9),
                   label="MRR", value="$120k", delta={"delta": +0.08},
                   tokens=tokens)
kpi.card, kpi.value_box              # constituent shapes stay tweakable

add_progress_bar(canvas, left=Inches(0.5), top=Inches(2.8),
                 width=Inches(6), height=Inches(0.3),
                 fraction=0.72, tokens=tokens)
add_gauge(canvas, left=Inches(0.5), top=Inches(3.4),
          width=Inches(4), height=Inches(0.3),
          fraction=0.6, target=0.8, tokens=tokens)
add_status_pill(canvas, left=Inches(0.5), top=Inches(4.1),
                width=Inches(1.6), height=Inches(0.5),
                text="On track", tokens=tokens)
add_stat_strip(canvas, left=Inches(0.5), top=Inches(4.9),
               width=Inches(9), height=Inches(1.6),
               items=[{"label": "ARR", "value": "$182M"},
                      {"label": "NDR", "value": "131%", "delta": +0.03}],
               tokens=tokens)
add_article_card(canvas, left=Inches(7.2), top=Inches(0.5),
                 width=Inches(2.5), height=Inches(3),
                 title="Q4 wrap", blurb="Highlights from the quarter",
                 cta_text="Read more", tokens=tokens)`;

const snippet5 = `from power_pptx import add_matplotlib_figure, add_svg_figure
from power_pptx.util import Inches

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

fig, ax = plt.subplots(figsize=(4, 3))
ax.plot([1, 2, 3, 4], [2, 4, 3, 5])

add_matplotlib_figure(slide, fig, Inches(1), Inches(1), Inches(4), Inches(3))
add_svg_figure(slide, "diagram.svg", Inches(6), Inches(1), Inches(3))

# add_plotly_figure(slide, fig, ...) works the same way (needs kaleido);
# all figure helpers raise FigureBackendUnavailable when the backend is missing`;

---

<DocsLayout
  title="Design System"
  description="DesignTokens, the shape.style facade, Grid/Stack layout primitives, slide recipes and shape-level building blocks."
>
  <p class="lead">
    The design layer gives generated decks a consistent visual language: tokens for palette,
    typography, shadows, radii and spacing; a token-resolving style facade; geometry-safe layout
    primitives; and opinionated recipes for whole slides.
  </p>

  <h2 id="tokens">DesignTokens</h2>
  <Code code={snippet0} />
  <p>
    <strong>Units.</strong> Every length — typography <code>size</code>, <code>radii</code>,
    <code>spacings</code>, shadow <code>blur_radius</code> (alias <code>blur</code>) and
    <code>distance</code> — is either a <code>Length</code> (<code>Pt(8)</code>,
    <code>Emu(101600)</code>), kept exactly, or a bare number read as <strong>points</strong>;
    <code>36</code> and <code>36.0</code> are the same, so a brand file from JSON or YAML behaves
    like the dict. For compatibility, a bare integer of 12700 or more is still read as EMU. Palette
    colours take hex strings, <code>RGBColor</code> or <code>[r, g, b]</code> lists.
  </p>
  <p>
    <strong>Keys are checked.</strong> A typography token takes <code>family</code>,
    <code>size</code>, <code>bold</code>, <code>italic</code> and <code>color</code>; a shadow
    token <code>blur_radius</code> / <code>blur</code>, <code>distance</code>,
    <code>direction</code>, <code>color</code> and <code>alpha</code>. Anything else, and a
    near-miss of a section name (<code>"palete"</code>), raises <code>ValueError</code> naming the
    token and the closest valid key. Other top-level keys are ignored, so a brand file can carry
    its own data.
  </p>

  <h2 id="style">The shape.style facade</h2>
  <Code code={snippet1} />

  <h2 id="layout">Grid and Stack</h2>
  <p>
    Layout primitives compute geometry from the slide's real dimensions, so you can't walk off the
    right edge:
  </p>
  <Code code={snippet2} />

  <h2 id="recipes">Slide recipes</h2>
  <Code code={snippet3} />
  <p>
    Recipes use the Blank layout, so <code>slide.shapes.title</code> is <code>None</code> — address
    shapes by index. On a template with no layout named "Blank" they take the layout with the
    fewest placeholders and remove those, so a recipe slide always starts empty. The module also
    has <code>section_divider</code>, <code>chart_slide</code>, <code>table_slide</code>,
    <code>code_slide</code>, <code>timeline_slide</code>, <code>comparison_slide</code> and
    <code>figure_slide</code>.
  </p>
  <Code code={snippet3b} />
  <p>
    <strong>Recipes fit their content and fail loudly.</strong> Where the text is known at build
    time, the fitting size is measured and written into the slide — an autofit flag alone does
    nothing in PowerPoint until the text is edited — and never below 9pt. Content that cannot fit
    at that size raises <code>ValueError</code> saying how much does fit, instead of writing an
    overflowing or unreadable slide: more than 9 KPIs in a row (12 on a 16:9 slide), more than 15
    timeline milestones (21), more than 21 comparison rows. Item dicts are validated too:
    <code>kpis</code> need <code>label</code> and <code>value</code> (optional
    <code>delta</code> / <code>delta_text</code>), <code>milestones</code>, comparison
    <code>rows</code> and chart <code>series</code> take exactly their documented keys, and a typo
    raises with a did-you-mean hint. A recipe that fails — a figure that cannot be embedded, an
    unknown alignment — leaves no half-built slide behind.
  </p>
  <p>
    Text in the recipes meets 4.5:1 contrast on the surface it sits on: a palette role that does
    not is darkened or lightened, keeping its hue. <code>code_slide</code> writes one installed
    monospace family (or the <code>font=</code> you pass) and picks text and syntax colours from
    the panel's brightness, so it reads with or without tokens. <code>timeline_slide</code> keeps
    labels on the slide and clear of the rail, and <code>chart_slide</code> takes
    <code>None</code> values as gaps.
  </p>

  <h2 id="components">Shape-level building blocks</h2>
  <p>
    Token-driven cards that return small dataclasses exposing their constituent shapes for further
    tweaks:
  </p>
  <Code code={snippet4} />
  <p>
    The KPI card lays its value, label and delta out for a 1.9" card and scales them down on a
    shorter one, raising <code>ValueError</code> below 0.95". <code>add_stat_strip</code> needs at
    least 0.75" of width per item and validates item keys the way <code>kpi_slide</code> does.
  </p>

  <h2 id="figures">Figure adapters</h2>
  <Code code={snippet5} />
  <p>
    Third-party deps import lazily; a missing backend raises
    <code>FigureBackendUnavailable</code> naming the exact pip package to install.
  </p>
</DocsLayout>
