---
import DocsLayout from "@/layouts/DocsLayout.astro";
import Code from "@/components/Code.astro";
import { withBase } from "@/lib/utils";

const jsonSpec = `from power_pptx.compose import from_spec

prs = from_spec({
    "slides": [
        {"layout": "title", "title": "Q4 Review", "subtitle": "Engineering"},
        {"layout": "bullets", "title": "Highlights",
         "bullets": ["Shipped v2.10", "Lint pass clean", "Zero overflow"]},
    ],
    "lint": "raise",
})
prs.save("q4.pptx")`;

const safeSpec = `from power_pptx.compose import SpecError, from_spec

try:
    prs = from_spec(spec_from_model, safe=True, base_dir="/srv/decks/job-42")
except SpecError as exc:
    exc.path   # "slides[2].kpis[0]" - where the bad value is
    str(exc)   # 'slides[2].kpis[0]: expected a mapping like {"label": "ARR", ...'
    # hand the message back to the model and ask for a corrected spec`;

const lintCli = `power-pptx lint build/*.pptx --format json      # one JSON document
power-pptx lint deck.pptx --fail-on warning     # stricter gate
power-pptx lint deck.pptx --fix --output tidied.pptx`;

const snippet0 = `pip install power-pptx
python -m power_pptx.skill install`;

const snippet1 = `# Print the skill source path inside the installed package
python -m power_pptx.skill path

# Install into another skills directory. TARGET is the skill's own
# directory (it will hold SKILL.md), not the skills/ folder around it.
python -m power_pptx.skill install --target /path/to/skills/power-pptx
python -m power_pptx.skill install /path/to/skills/power-pptx   # same thing

# Fail if anything already exists at the target, even an earlier install
python -m power_pptx.skill install --no-overwrite

# power-pptx-skill is the same command as an installed script
power-pptx-skill install`;

