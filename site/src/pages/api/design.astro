---
import DocsLayout from "@/layouts/DocsLayout.astro";
import Code from "@/components/Code.astro";
import { withBase } from "@/lib/utils";

const s0 = `from power_pptx.design.tokens import DesignTokens

tokens = DesignTokens.from_dict({      # dict-shaped tokens
    "palette": {"primary": "#0B5CFF", "ink": [13, 13, 13]},   # hex or [r, g, b]
    "typography": {"heading": {"family": "Inter", "size": 44},   # bare number = pt
                   "body": {"family": "Inter", "size": 18}},
    "shadows": {"card": {"blur": 18, "distance": 4, "alpha": 0.18}},  # blur = blur_radius
})
tokens = DesignTokens.from_yaml("brand.yaml")   # needs pyyaml
tokens = DesignTokens.from_pptx("brand.pptx")   # path, Path, binary file or Presentation
tokens = tokens.with_overrides({"typography.heading.size": 40})
tokens = tokens.merge(DesignTokens.from_dict({"palette": {"accent": "#FF6600"}}))

# token namespaces: palette, typography, shadows, radii, spacings
tokens.palette["accent1"]              # -> RGBColor (pass straight to setters)
tokens.typography["heading"]           # -> TypographyToken (family, size, ...)
tokens.typography["heading"].size.pt   # 40.0 - lengths are Length objects`;

const s1 = `from power_pptx import Presentation, BBox
from power_pptx.design.layout import Grid, Stack
from power_pptx.util import Inches, Pt
from power_pptx.enum.shapes import MSO_SHAPE

prs = Presentation()
slide = prs.slides.add_slide(prs.slide_layouts[6])

grid = Grid(slide, cols=12, rows=6, gutter=Pt(12), margin=Pt(48))
card = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, *BBox.from_inches(1, 1, 2, 2))
grid.place(card, col=0, row=0, col_span=6, row_span=4)   # move into a span
box = grid.cell(col=6, row=0, col_span=6, row_span=4)    # or just compute one

stack = Stack(direction="vertical", gap=Pt(8),
              left=Inches(1), top=Inches(4), width=Inches(8))
stack.place(card, height=Pt(120))      # walks the cursor down per placement

# token-resolving style facade: attribute setters fan out to proxies
card.style.fill = tokens.palette["accent1"]
card.style.line = tokens.palette["accent2"]`;

const s2 = `from power_pptx.design.recipes import (
    title_slide, bullet_slide, kpi_slide, quote_slide, image_hero_slide,
)

title_slide(prs, title="Q4", subtitle="Engineering", tokens=tokens)
bullet_slide(prs, title="Highlights", bullets=["One", "Two"], tokens=tokens)
kpi_slide(prs, title="KPIs",
          kpis=[{"label": "ARR", "value": "$4.2M", "delta": +0.08}],
          tokens=tokens)
quote_slide(prs, quote="Ship it.", attribution="The team", tokens=tokens)
image_hero_slide(prs, title="Big news", image="hero.png", tokens=tokens)

from power_pptx.design.recipes import (
    section_divider, chart_slide, table_slide, code_slide,
    timeline_slide, comparison_slide, figure_slide,
)

section_divider(prs, title="Part two", eyebrow="Roadmap", progress=(2, 4))
chart_slide(prs, title="ARR", chart_type="line", categories=["Q1", "Q2", "Q3"],
            series=[{"name": "ARR", "values": [1.2, None, 2.4]}])   # None = gap
table_slide(prs, title="Owners", columns=["Region", "Owner"],
            rows=[["EMEA", "Priya"]], widths=[2, 1])      # relative weights
code_slide(prs, title="Setup", code="pip install power-pptx",
           font=None, overflow="truncate")                # or overflow="raise"
timeline_slide(prs, title="Plan", milestones=[{"label": "Beta", "date": "Q3"},
                                              {"label": "GA", "date": "Q4"}])
comparison_slide(prs, title="Before / after", left_heading="Before",
                 right_heading="After", rows=[{"left": "Manual", "right": "Automated"}])
figure_slide(prs, title="Adoption", figure="chart.png",
             fit="contain")                               # | "cover" | "stretch"`;

const s3 = `from power_pptx import (
    add_kpi_card, add_progress_bar, add_gauge,
    add_status_pill, add_stat_strip, add_article_card,
    KpiCard, ProgressBar, Gauge, StatusPill, StatStrip, ArticleCard,
)

kpi = add_kpi_card(slide, left=Inches(1), top=Inches(1),
                   width=Inches(2.5), height=Inches(1.9),
                   label="MRR", value="$120k",
                   delta={"delta": +0.08}, tokens=tokens)
kpi.card, kpi.value_box, kpi.delta_box   # constituent shapes stay tweakable

from power_pptx import (
    add_plotly_figure, add_matplotlib_figure,
    add_svg_figure, add_html_figure, FigureBackendUnavailable,
)

add_svg_figure(slide, "diagram.svg", Inches(6), Inches(1), Inches(3))
# add_matplotlib_figure / add_plotly_figure take (slide, figure, left, top, ...)
# and raise FigureBackendUnavailable when the backend isn't installed`;
---

<DocsLayout
  title="API: Design System"
  description="DesignTokens, Grid/Stack layout, slide recipes, shape components and figure adapters."
>
  <h2 id="tokens"><code>DesignTokens</code> <strong class="text-primary">fork</strong></h2>
  <Code code={s0} />
  <p>
    A bare number in a length field is points; a bare integer of 12700 or more is still EMU, and a
    <code>Length</code> is kept as given. Unknown typography and shadow keys, and near-miss section
    names, raise <code>ValueError</code> with a did-you-mean hint. See
    <a href={withBase("/advanced/design")}>Design System</a>.
  </p>

  <h2 id="layout"><code>Grid</code> / <code>Stack</code> <strong class="text-primary">fork</strong></h2>
  <Code code={s1} />

  <h2 id="recipes">Slide recipes <strong class="text-primary">fork</strong></h2>
  <Code code={s2} />
  <p>
    Every recipe appends a slide on the Blank layout (or the layout with the fewest placeholders,
    emptied) and returns it; all take <code>tokens=</code> and <code>transition=</code>. Content
    that cannot fit at 9pt raises <code>ValueError</code> saying how much fits, and malformed item
    dicts (<code>kpis</code>, <code>milestones</code>, comparison <code>rows</code>, chart
    <code>series</code>) raise with a did-you-mean hint; a failed recipe leaves no slide behind.
    <code>table_slide(widths=)</code> reads bare numbers as relative weights and
    <code>Length</code> values as exact widths. <code>figure_slide(fit=)</code> defaults to
    <code>"contain"</code>, keeping the figure's aspect ratio.
  </p>

  <h2 id="components">Shape components &amp; figure adapters <strong class="text-primary">fork</strong></h2>
  <Code code={s3} />
</DocsLayout>
