  <table>
    <thead>
      <tr><th>Function</th><th>Result dataclass</th></tr>
    </thead>
    <tbody>
      <tr><td><code>horizontal_pipeline(slide, bbox, steps, accent=...)</code></td><td><code>PipelineResult</code></td></tr>
      <tr><td><code>vertical_pipeline(slide, bbox, steps, ...)</code></td><td><code>PipelineResult</code></td></tr>
      <tr><td><code>hub_and_spoke(slide, bbox, centre, spokes, ...)</code></td><td><code>HubAndSpokeResult</code></td></tr>
      <tr><td><code>cycle(slide, bbox, steps, ...)</code></td><td><code>CycleResult</code></td></tr>
      <tr><td><code>decision_tree(slide, bbox, root, branches, ...)</code></td><td><code>DecisionTreeResult</code></td></tr>
      <tr><td><code>comparison_columns(slide, bbox, columns, ...)</code></td><td><code>ColumnsResult</code></td></tr>
