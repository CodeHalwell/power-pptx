---
import DocsLayout from "@/layouts/DocsLayout.astro";
import Code from "@/components/Code.astro";

const bbox = `from power_pptx import BBox
from power_pptx.util import Inches

bb = BBox.from_inches(x=1, y=2, w=8, h=4)
BBox.from_shape(shape)         # wrap an existing shape's frame
BBox.from_slide(slide)         # the whole slide canvas

bb.right, bb.bottom            # far edges (EMU)
bb.cx, bb.cy                   # centre (EMU)
bb.area
*bb                            # splats to (left, top, width, height)
bb.as_tuple()

bb.shifted(dx=..., dy=...)
bb.resized(w=..., h=..., anchor="center")
bb.inset(all=Inches(0.2))      # or x=/y=/left=/right=/top=/bottom=
bb.sub(fx=0, fy=0, fw=0.5, fh=1)      # fractional sub-region
bb.split_h([1, 1], gap=Inches(0.2))   # columns by ratio
bb.split_v([2, 1], gap=Inches(0.1))   # rows by ratio
bb.grid(rows=2, cols=3, gap=Inches(0.1))
bb.contains(other, tol=0)
bb.intersects(other)
bb.intersection(other)         # BBox | None
bb.union(other)
bb.apply_to(shape)             # move/resize a shape in place`;

const tree = `shapes = slide.shapes

shapes.add_text(bb, text="Hi", size_pt=24, bold=True,
                color="#0B5CFF", align="center", anchor="middle")
shapes.add_shape(MSO_SHAPE.RECTANGLE, *bb, anchor="center")
shapes.add_textbox(*bb)
shapes.add_picture("img.png", *bb, anchor="center")
shapes.add_table(rows, cols, *bb, style="clean")
shapes.add_chart(XL_CHART_TYPE.COLUMN_CLUSTERED, x, y, cx, cy, chart_data)
shapes.add_connector(MSO_CONNECTOR.STRAIGHT, x1, y1, x2, y2)   # bare line!
shapes.add_arrow(start=shape_a, end=shape_b, head="triangle",
                 color="#0B5CFF", weight_pt=1.5, inset_pt=6)
shapes.add_group_shape()
shapes.build_freeform(start_x, start_y, scale)
shapes.add_svg_picture("diagram.svg", *bb, png_fallback="d.png")
shapes.clone_layout_placeholders(slide_layout)
shapes.add_movie("clip.mp4", x, y, w, h, poster_frame_image=None)`;

const shape = `shape.left / .top / .width / .height   # EMU, mutable
shape.name, shape.shape_id, shape.shape_type
shape.rotation, shape.shadow
shape.click_action             # hyperlinks / jump targets
shape.fill / .line             # FillFormat / LineFormat
shape.fill_hex("#0B5CFF")      # fork: chainable hex helpers
shape.line_hex("#0D0D0D", weight_pt=1.25)
shape.effect                   # fork: shadow/glow/soft-edges/blur/reflection
shape.three_d                  # fork: bevel / extrusion / rotation
shape.set_text_preserving_format("New text")   # fork
shape.bbox                     # fork: BBox view of the frame`;

const pic = `picture.image                # Image (blob, filename, size, ext)
picture.crop_left / .crop_top / .crop_right / .crop_bottom
picture.transparency           # fork: 0..1
picture.brightness, .contrast  # fork
picture.recolor("grayscale")   # fork: grayscale | sepia | washout | duotone
picture.enclosing_container()  # fork: the surrounding card, if any
picture.replace_with(builder, padding=...)     # fork`;
---

<DocsLayout
  title="API: Shapes & Geometry"
  description="BBox, the shape tree, autoshapes, pictures, connectors, groups, freeforms, tables, placeholders and diagram recipes."
>
  <h2 id="bbox"><code>power_pptx.BBox</code> <strong class="text-primary">fork</strong></h2>
  <p>
    Immutable rectangular region. Construct with <code>from_inches</code>, <code>from_emu</code>,
    <code>from_shape</code> or <code>from_slide</code>.
  </p>
  <Code code={bbox} />

  <h2 id="shapetree"><code>power_pptx.shapes.shapetree</code> — the shape tree</h2>
  <p>
    <code>slide.shapes</code> is a <code>SlideShapes</code> sequence (index, iterate,
    <code>len()</code>) with factory methods:
  </p>
  <Code code={tree} />

  <h2 id="baseshape"><code>BaseShape</code> and subclasses</h2>
  <p>
    <code>Shape</code> (autoshape), <code>Picture</code>, <code>GraphicFrame</code> (table/chart),
    <code>GroupShape</code>, <code>Connector</code>, <code>FreeformBuilder</code> output,
    <code>Movie</code>, and the placeholder hierarchy
    (<code>SlidePlaceholder</code>, <code>TitlePlaceholder</code>, <code>PicturePlaceholder</code>,
    <code>ChartPlaceholder</code>, <code>TablePlaceholder</code>) all share:
  </p>
  <Code code={shape} />

  <h2 id="picture"><code>Picture</code> extras</h2>
  <Code code={pic} />

