---
import DocsLayout from "@/layouts/DocsLayout.astro";
import Code from "@/components/Code.astro";

const s0 = `from power_pptx.chart.data import CategoryChartData, XyChartData, BubbleChartData

data = CategoryChartData()
data.categories = ["Q1", "Q2", "Q3", "Q4"]
data.add_series("Revenue", (1.2, 1.8, 2.4, 3.1))

chart = slide.shapes.add_chart(
    XL_CHART_TYPE.COLUMN_CLUSTERED, x, y, cx, cy, data
).chart`;

const s1 = `chart.chart_type
chart.plots                        # sequence of Plot
plot = chart.plots[0]
plot.series                        # sequence of Series
plot.has_data_labels = True
plot.vary_by_categories

series = plot.series[0]
series.name, series.values
series.format.fill.gradient(kind="linear", angle=0)   # fork
series.format.fill.pattern(MSO_PATTERN_TYPE.PERCENT_40)

chart.category_axis / .value_axis
axis.has_major_gridlines, axis.tick_labels,
axis.maximum_scale / .minimum_scale
chart.category_axis.reverse_order  # BAR_* defaults True (fork)

chart.has_legend = True
chart.legend.position = XL_LEGEND_POSITION.BOTTOM
chart.chart_style = 10             # built-in style index 1..48`;

const s2 = `from power_pptx.chart import palettes, quick_layouts

chart.recolour("ocean")            # fork: one call, dispatches per type
chart.apply_palette(palettes.OCEAN)  # warns on pie/doughnut
chart.apply_dark_theme(text="#E5E7EB", line="#374151")   # fork
chart.line_color = "#9CA3AF"       # fork

quick_layouts.apply_quick_layout(chart, "minimal")  # 10 presets`;
---

<DocsLayout
  title="API: Charts"
  description="Chart, Plot, Series, axes, legends, chart data classes, palettes and quick layouts."
>
  <h2 id="data">Chart data</h2>
  <p>
    <code>CategoryChartData</code>, <code>XyChartData</code>, <code>BubbleChartData</code> feed
    <code>add_chart</code>. An embedded XLSX workbook is written automatically.
  </p>
  <Code code={s0} />

  <h2 id="chart"><code>Chart</code>, <code>Plot</code>, <code>Series</code></h2>
  <Code code={s1} />

  <h2 id="palettes">Palettes &amp; quick layouts <strong class="text-primary">fork</strong></h2>
  <Code code={s2} />

  <h2 id="types">Chart types</h2>
  <p>
    <code>XL_CHART_TYPE</code> covers the full OOXML set: <code>COLUMN_*</code>, <code>BAR_*</code>,
    <code>LINE*</code>, <code>PIE*</code>, <code>DOUGHNUT*</code>, <code>AREA*</code>,
    <code>XY_SCATTER*</code>, <code>BUBBLE*</code>, <code>RADAR*</code>, <code>STOCK_*</code>,
    <code>SURFACE*</code>, … See the
    <a href="https://python-pptx.readthedocs.io/en/latest/api/enum/XlChartType.html" target="_blank" rel="noopener noreferrer">upstream enum docs</a>
    for the complete member list.
  </p>
</DocsLayout>
